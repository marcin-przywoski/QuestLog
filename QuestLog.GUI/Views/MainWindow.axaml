<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuestLog.GUI.ViewModels"
        xmlns:models="using:QuestLog.GUI.Models"
        xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="QuestLog.GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="QuestLog"
        Width="1000" Height="600">

    <Design.DataContext>
        <vm:MainWindowViewModel ShowUnreadOnly="True"
                                StatusMessage="Loaded 3 email(s)"
                                SelectedEmail="{x:Static models:DesignData.KickoffEmail}"
                                AvailableUpdate="{x:Static models:DesignData.SampleUpdate}" />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#f0f0f0" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Load Emails" 
                        Command="{Binding LoadEmailsCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Padding="15,8"/>
                <Button Content="Mark as Read" 
                        Command="{Binding MarkAsReadCommand}"
                        IsEnabled="{Binding SelectedEmail, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                        Padding="15,8"/>
                <CheckBox Content="Show Unread Only" 
                          IsChecked="{Binding ShowUnreadOnly}"
                          VerticalAlignment="Center"
                          Margin="20,0,0,0"/>
                <Button Content="Check for updates" 
                        Command="{Binding CheckForUpdatesCommand}"
                        IsEnabled="{Binding !IsCheckingForUpdates}"
                        Padding="15,8"/>
                <Button Content="Restart to update" 
                      Command="{Binding ApplyUpdateCommand}"
                      IsVisible="{Binding AvailableUpdate, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="{Binding AvailableUpdate.Version, StringFormat='Downloaded update: {0}'}"
                      Padding="15,8"/>
                <ProgressBar IsIndeterminate="True" 
                             IsVisible="{Binding IsLoading}"
                             Width="100"
                             VerticalAlignment="Center"
                             Margin="20,0,0,0"/>
                <ProgressBar IsIndeterminate="True" 
                             IsVisible="{Binding IsCheckingForUpdates}"
                             Width="100"
                             VerticalAlignment="Center"
                             Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Update notice (release notes) - shown above the emails, never replaces them -->
        <Border Grid.Row="1" Background="#fffbe6" BorderBrush="#e6d9a8" BorderThickness="0,1,0,1" Padding="16,10"
                IsVisible="{Binding AvailableUpdate, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
            <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="6" DataContext="{Binding AvailableUpdate}">
                    <TextBlock Text="{Binding Version, StringFormat='Update {0} available - restart to update'}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding NotesMarkdown}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="Gray"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnDefinitions="350,*">
            
            <!-- Email List -->
            <Border Grid.Column="0" BorderBrush="#e0e0e0" BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Emails}" 
                         SelectedItem="{Binding SelectedEmail}"
                         Background="White">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Email">
                            <Border Padding="10" BorderBrush="#e8e8e8" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding Sender}" 
                                                   FontWeight="{Binding IsRead, Converter={StaticResource BoolToFontWeightConverter}}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding ReceivedDate, StringFormat={}{0:MM/dd HH:mm}}"
                                                   Foreground="Gray"
                                                   FontSize="11"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Subject}" 
                                               FontWeight="{Binding IsRead, Converter={StaticResource BoolToFontWeightConverter}}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Body}" 
                                               Foreground="Gray"
                                               FontSize="12"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Email Detail -->
            <Border Grid.Column="1" Background="White" Padding="20">
                <ScrollViewer IsVisible="{Binding SelectedEmail, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="15" DataContext="{Binding SelectedEmail}">
                        <TextBlock Text="{Binding Subject}" 
                                   FontSize="20" 
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="From:" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Sender}"/>
                            <TextBlock Text="{Binding SenderEmail, StringFormat='&lt;{0}&gt;'}" Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Date:" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ReceivedDate, StringFormat='dddd, MMMM d, yyyy h:mm tt'}"/>
                        </StackPanel>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="{Binding Body}" 
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#f0f0f0" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="Gray"/>
        </Border>
    </Grid>

</Window>
